# Optional Playwright integration. Copy to .env.runtime.local and set local paths.
# Use npm run dev:configured or npm run server:configured to load this file.
FOUND_LOCAL_PLAYWRIGHT_MODULE=
FOUND_LOCAL_CHROMIUM=
# Only the exact value false disables Chromium's process sandbox.
FOUND_LOCAL_CHROMIUM_SANDBOX=true
# Comma-separated, explicitly reviewed public directory hostnames (no URLs).
FOUND_LOCAL_PUBLIC_DIRECTORY_HOSTS=

# Optional Bright Data Google Search and Maps production integration. Never commit the token.
# SERP API is primary; Browser API is the one-attempt fallback for eligible failures.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=
# Complete credential-bearing Browser API WebSocket URL. Keep this local.
# Example shape: wss://<zone-username>:<zone-password>@brd.superproxy.io:9222
BRIGHTDATA_BROWSER_CDP_URL=
# Optional Google localization; defaults are us and en. Use a documented Google
# canonical location value for BRIGHTDATA_SERP_LOCATION when location pinning is needed.
BRIGHTDATA_SERP_COUNTRY=us
BRIGHTDATA_SERP_LANGUAGE=en
BRIGHTDATA_SERP_LOCATION=
