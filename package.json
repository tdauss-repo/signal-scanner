{
  "name": "business-scanner-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "api": "npm run server",
    "dev:all": "node scripts/dev-all.mjs",
    "diagnose:website": "node scripts/diagnose-website-fetch.mjs",
    "test:proving-001": "node --import tsx scripts/test-website-audit.ts && node --import tsx scripts/test-website-evidence-contract.ts",
    "test:proving-002": "node --import tsx scripts/test-browser-website-observation.ts",
    "test:profile-separation": "node --import tsx scripts/test-profile-separation.ts",
    "test:visibility-workflow": "node --import tsx scripts/test-visibility-workflow.ts",
    "test:packet-a": "node --import tsx scripts/test-packet-a.ts",
    "test:packet-b": "node --import tsx scripts/test-packet-b.ts",
    "test:packet-c": "node --import tsx scripts/test-packet-c.ts",
    "test:packet-d": "node --import tsx scripts/test-packet-d.ts && node --import tsx scripts/test-live-https-integration.ts",
    "prove:acquisition": "node --import tsx scripts/prove-acquisition.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:packet-e": "node --import tsx scripts/test-packet-e.ts",
    "prove:visibility-scan": "node --env-file-if-exists=.env.runtime.local --import tsx scripts/prove-visibility-scan.ts",
    "server:configured": "node --env-file=.env.runtime.local --import tsx server/index.ts",
    "dev:configured": "node --env-file=.env.runtime.local scripts/dev-all.mjs",
    "test:packet-e1": "node --import tsx scripts/test-packet-e1.ts",
    "test:packet-e1a": "node --import tsx scripts/test-packet-e1a.ts",
    "test:public-presence-promotion": "node --import tsx scripts/test-public-presence-promotion.ts",
    "test:operator-assisted-search": "node --import tsx scripts/test-operator-assisted-search.ts",
    "prove:google-persistent-browser": "xvfb-run -a node --env-file=.env.runtime.local --import tsx scripts/prove-google-persistent-browser.ts",
    "prove:brightdata-google": "node --env-file-if-exists=.env.runtime.local --import tsx scripts/prove-brightdata-google.ts",
    "prove:google-brightdata": "node --env-file-if-exists=.env.runtime.local --import tsx scripts/prove-google-brightdata.ts",
    "test:google-brightdata": "node --import tsx scripts/test-google-brightdata.ts",
    "test:visibility-snapshot": "node --import tsx scripts/test-visibility-snapshot.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
